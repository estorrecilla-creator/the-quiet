ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Opcional: para buscar vídeo libre de derechos en vez de generar portadas
# con IA (gratis, aprobación instantánea): https://www.pexels.com/api/
PEXELS_API_KEY=...

# Opcional: segunda fuente de vídeo libre de derechos, se usa como
# respaldo si Pexels no encuentra nada para una búsqueda (gratis,
# aprobación instantánea): https://pixabay.com/api/docs/
PIXABAY_API_KEY=...

# Opcional: tercera fuente de vídeo libre de derechos, se usa como
# respaldo si Pexels y Pixabay no encuentran nada (gratis, pero hay que
# pedirla por email a team@coverr.co): https://api.coverr.co/docs/start/
COVERR_API_KEY=...

# Opcional: se usan para rellenar los metadatos finales del audio
# (productor, editorial, copyright y copyright fonográfico) — si no las
# pones, se usa el nombre del artista de cada tema como valor por defecto.
RELEASE_PUBLISHER=Neural Void MUSIC
RELEASE_COPYRIGHT_HOLDER=Tu Nombre

# Solo hacen falta si vas a usar src/meta_uploader.py (Facebook/Instagram)
PAGE_ID=...
PAGE_ACCESS_TOKEN=...
IG_USER_ID=...

# Solo hacen falta si vas a publicar los Shorts también en Instagram
# (tools/subir_shorts_instagram.py) -- cuenta gratuita de Cloudflare R2,
# necesaria porque Instagram exige una URL pública del vídeo para poder
# publicarlo (ver src/cloud_storage.py para cómo conseguirlas).
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=...
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Solo hacen falta si vas a publicar los Shorts también en Bluesky
# (tools/subir_shorts_bluesky.py) -- BLUESKY_APP_PASSWORD es una
# "contraseña de aplicación" (Configuración -> Contraseñas de
# aplicaciones dentro de Bluesky), NUNCA la contraseña normal de la
# cuenta. No hace falta ninguna revisión ni cuenta vinculada, a
# diferencia de Instagram.
BLUESKY_HANDLE=iwt.oficial.bsky.social
BLUESKY_APP_PASSWORD=...

# Solo hacen falta si vas a publicar los Shorts también en TikTok
# (tools/subir_shorts_tiktok.py) -- se consiguen creando una app en
# developers.tiktok.com con el scope "video.publish". TIKTOK_REDIRECT_URI
# debe coincidir EXACTAMENTE con el registrado para esa app. Tras
# rellenar esto, ejecuta UNA VEZ `python tools/autorizar_tiktok.py` para
# la autorización inicial (ver src/tiktok_auth.py). Mientras la app no
# pase la revisión de TikTok, todo lo publicado sale en modo privado
# (SELF_ONLY) -- ver el aviso en src/tiktok_uploader.py.
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_REDIRECT_URI=http://localhost:8080/callback
